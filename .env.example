# Copy this file to .env (never commit .env) and fill in your own key.
# The Flask server reads it at start-up; the browser never sees the key.
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_VOICE=Kore
# GEMINI_DAILY_LIMIT=500        # total Gemini calls per day for this server
